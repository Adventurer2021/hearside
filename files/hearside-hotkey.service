[Unit]
Description=HearSide hotkeys (Win+H dictation, Meta+Shift+H captions) via KDE kglobalaccel
After=graphical-session.target
# Stop at logout and start fresh at login, so the shortcut is registered with the
# current session's KWin even when user linger keeps the user manager running.
PartOf=graphical-session.target
# Installed once for every user (systemctl --global enable). A user who still has the
# older per-user HearSide install keeps using that instead, so the two never run twice.
ConditionPathExists=!%h/.config/systemd/user/dictation-hotkey.service
# Accounts the installer set up for HearSide (dictation types through /dev/uinput, "input" group).
ConditionGroup=input

[Service]
ExecStart=/opt/hearside/venv/bin/python3 /opt/hearside/hotkey_listener.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
